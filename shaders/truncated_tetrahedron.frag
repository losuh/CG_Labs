#version 450 core

// location 0 совпадает с выходом вершинного шейдера. flat сохраняет
// один цвет на весь треугольник, поэтому грань выглядит плоской.
layout(location = 0) flat in vec3 in_color;
// Выходной vec4 содержит RGB и непрозрачность фрагмента.
layout(location = 0) out vec4 out_color;

void main() {
    // Цвет приходит без интерполяции из вершинного шейдера. Альфа 1
    // делает поверхность полностью непрозрачной.
    out_color = vec4(in_color, 1.0);
}
